pipeline {
    agent any

    stages {
        stage('Checkout code') {
            steps {
                echo 'Checkout code...'
                script {
                    git branch: 'master',
                        credentialsId: 'git',
                        url: 'https://github.com/FelipeRP94/bootcamp-devops-lemoncode.git'
                }
            }
        }

        dir('03-cd/exercises/jenkins-resources/calculator') {
            stage('Compile') {
                steps {
                    echo 'Compiling...'
                    sh './gradlew compileJava'
                }
            }
        } 
    }
}